{
  "name": "tu-recommend",
  "version": "1.0.0",
  "description": "Express.js API with Prisma, MinIO, Redis, and Mailpit",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test:flow": "pnpm build && node scripts/check-flow.js",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node src/prisma/seed.ts",
    "prisma:seed:prod": "node dist/prisma/seed.js",
    "prisma:refresh": "prisma migrate reset --force && ts-node src/prisma/seed.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:start": "./scripts/docker-start.sh",
    "docker:stop": "./scripts/docker-stop.sh",
    "deps:check": "bash scripts/check-deps.sh",
    "deps:fix": "bash scripts/check-deps.sh --fix"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "node dist/prisma/seed.js"
  },
  "keywords": [
    "express",
    "prisma",
    "typescript",
    "minio",
    "redis",
    "mailpit"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "7.1.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "3.9.6",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
