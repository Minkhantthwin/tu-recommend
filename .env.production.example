# PostgreSQL
POSTGRES_PASSWORD=your-strong-postgres-password-here

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters

# Redis
REDIS_PASSWORD=your-strong-redis-password-here

# MinIO
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key-minimum-8-chars

# Mail (Use a real SMTP service in production like SendGrid, Mailgun, etc.)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=your-sendgrid-api-key
MAIL_FROM=noreply@your-domain.com